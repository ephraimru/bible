# Uncomment this line to define a global platform for your project
# platform :ios, '12.0'

# CocoaPods analytics sends network stats synchronously on CDN edge requests and does
# not comply with the ITMS Store Privacy Policy (https://apple.co/2f4T73C)
# Stop CocoaPods from sending analytics during install
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

use_frameworks!
use_modular_headers!

# Define the target
ABITargets = ['arm64']

target 'Runner' do
  use_frameworks!
  use_modular_headers!
  
  # Flutter Pods
  copied_flutter_dir = File.join(__dir__, 'Flutter')
  copied_framework_path = File.join(copied_flutter_dir, 'Flutter.framework')
  copied_podspecs_path = File.join(copied_flutter_dir, 'Generated.xcconfig')
  
  unless File.exist?(copied_framework_path) && File.exist?(copied_podspecs_path)
    # Copy Flutter.framework and podspecs to Flutter/ to have something to link against if the xcode backend script has not run yet.
    # That script will copy the correct debug/profile/release version of the Flutter framework based on the currently selected Xcode configuration.
    flutter_application_path = File.expand_path('Flutter')
    flutter_framework_path = File.expand_path('Flutter/Flutter.framework')
    FileUtils.mkdir_p(flutter_application_path)
    
    flutter_framework = File.expand_path('#{File.dirname(__FILE__)}/../.symlinks/flutter/arm64/Flutter.framework')
    if File.exist?(flutter_framework)
      FileUtils.cp_r(flutter_framework, flutter_framework_path)
    end
    
    flutter_libpodspecs = File.expand_path('#{File.dirname(__FILE__)}/../.symlinks/flutter/arm64/Generated.xcconfig')
    if File.exist?(flutter_libpodspecs)
      FileUtils.cp_r(flutter_libpodspecs, File.join(copied_flutter_dir, 'Generated.xcconfig'))
    end
  end

  # Flutter Pods
  pod 'Flutter', :path => 'Flutter'
  
  # Firebase Pods
  pod 'Firebase/CoreOnly', '~> 10.0'
  pod 'Firebase/Analytics', '~> 10.0'
  pod 'Firebase/Auth', '~> 10.0'
  pod 'Firebase/Firestore', '~> 10.0'
  pod 'Firebase/Storage', '~> 10.0'
  pod 'Firebase/Messaging', '~> 10.0'
  pod 'Firebase/Crashlytics', '~> 10.0'
  
  # In-App Purchases
  pod 'StoreKit', '~> 2.0'
  
  # Notifications
  pod 'FlutterLocalNotifications', '~> 16.0'
  
  # ML Kit
  pod 'GoogleMLKit/TextRecognition', '~> 4.0'
  pod 'GoogleMLKit/NaturalLanguage', '~> 4.0'
  
  target 'RunnerTests' do
    inherit! :search_paths
  end
  
  target 'RunnerUITests' do
    inherit! :search_paths
  end
  
  post_install do |installer|
    installer.pods_project.targets.each do |target|
      flutter_additional_ios_build_settings(target)
      
      # Enable code signing for Firebase
      target.build_configurations.each do |config|
        config.build_settings['CODE_SIGNING_REQUIRED'] = 'YES'
        config.build_settings['CODE_SIGNING_ALLOWED'] = 'YES'
      end
      
      # Fix for Firebase pods
      if target.name.start_with?('Firebase') || target.name.start_with?('FBLPromises') || target.name.start_with?('GoogleUtilities')
        target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '12.0'
          config.build_settings['ONLY_ACTIVE_ARCH'] = 'YES'
        end
      end
      
      # Fix for FlutterLocalNotifications
      if target.name == 'FlutterLocalNotifications'
        target.build_configurations.each do |config|
          config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = '$(inherited) PERMISSION_NOTIFICATIONS=1 PERMISSION_CAMERA=1 PERMISSION_MICROPHONE=1'
        end
      end
    end
  end
end
