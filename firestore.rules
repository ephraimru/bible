rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ============ USERS ============
    match /users/{userId} {
      // Only the user can read/write their own document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Admins can read all users
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ VERSES ============
    match /verses/{verseId} {
      // Anyone can read verses
      allow read: if request.auth != null;
      
      // Only admins can write verses
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ DAILY VERSES ============
    match /daily_verses/{date} {
      // Anyone can read daily verses
      allow read: if request.auth != null;
      
      // Only admins can write daily verses
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ BLOG POSTS ============
    match /blog_posts/{postId} {
      // Anyone can read published posts
      allow read: if request.auth != null && 
        (resource.data.status == 'published' || 
         resource.data.authorId == request.auth.uid);
      
      // Only author can write their own posts
      allow create: if request.auth != null && 
        request.resource.data.authorId == request.auth.uid &&
        _canUserPost(request.auth.uid);
      
      allow update, delete: if request.auth != null && 
        resource.data.authorId == request.auth.uid;
    }
    
    // Blog post comments
    match /blog_posts/{postId}/comments/{commentId} {
      // Anyone can read comments
      allow read: if request.auth != null;
      
      // Only author can write their own comments
      allow create: if request.auth != null;
      
      allow update, delete: if request.auth != null && 
        resource.data.authorId == request.auth.uid;
    }
    
    // ============ CHAT ROOMS ============
    match /chat_rooms/{roomId} {
      // Anyone can read chat rooms
      allow read: if request.auth != null;
      
      // Only admins can create chat rooms
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
      
      // Room members can update (join/leave)
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists ||
         resource.data.memberIds.hasAny([request.auth.uid]));
    }
    
    // Chat room messages
    match /chat_rooms/{roomId}/messages/{messageId} {
      // Room members can read messages
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]);
      
      // Room members can create messages
      allow create: if request.auth != null && 
        get(/databases/$(database)/documents/chat_rooms/$(roomId)).data.memberIds.hasAny([request.auth.uid]) &&
        _isMessageValid(request.resource.data);
      
      // Only message author can update/delete
      allow update, delete: if request.auth != null && 
        resource.data.senderId == request.auth.uid;
    }
    
    // ============ FAITH JOURNEYS ============
    match /faith_journeys/{userId} {
      // Only the user can read/write their own faith journey
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ============ READING HABITS ============
    match /reading_habits/{userId} {
      // Only the user can read/write their own reading habit
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // ============ SUBSCRIPTIONS ============
    match /subscriptions/{subscriptionId} {
      // Only the user can read their own subscriptions
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Only admins can write subscriptions
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ PAYMENTS ============
    match /payments/{paymentId} {
      // Only the user can read their own payments
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Only admins can write payments
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ NOTIFICATIONS ============
    match /notifications/{notificationId} {
      // Only the user can read their own notifications
      allow read: if request.auth != null && 
        resource.data.userId == request.auth.uid;
      
      // Only admins can write notifications
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ MODERATION REPORTS ============
    match /moderation_reports/{reportId} {
      // Only admins and moderators can read reports
      allow read: if request.auth != null && 
        (get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists ||
         get(/databases/$(database)/documents/moderators/$(request.auth.uid)).exists);
      
      // Anyone can create reports
      allow create: if request.auth != null;
      
      // Only admins and moderators can update reports
      allow update: if request.auth != null && 
        (get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists ||
         get(/databases/$(database)/documents/moderators/$(request.auth.uid)).exists);
    }
    
    // ============ PREMIUM CONTENT ============
    match /premium_content/{contentId} {
      // Anyone can read premium content
      allow read: if request.auth != null;
      
      // Only admins can write premium content
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ ADMINS ============
    match /admins/{adminId} {
      // Only admins can read/write admins
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
    
    // ============ MODERATORS ============
    match /moderators/{moderatorId} {
      // Only admins can read/write moderators
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).exists;
    }
  }
}

// Helper functions
function _canUserPost(userId) {
  // Check if user is bishop or has blog posting permission
  return get(/databases/$(database)/documents/users/$(userId)).data.role in ['bishop', 'shepherd'] ||
         get(/databases/$(database)/documents/users/$(userId)).data.canPostOnBlog == true;
}

function _isMessageValid(message) {
  // Basic message validation
  // Check for empty content
  if (!message.content.size() > 0) {
    return false;
  }
  
  // Check content length
  if (message.content.size() > 1000) {
    return false;
  }
  
  // Check for blocked words (simplified)
  // In production, you would implement more sophisticated checks
  
  return true;
}
