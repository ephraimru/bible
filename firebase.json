            "storageBucket": "faith-mission-app.appspot.com",
            "measurementId": "YOUR_MEASUREMENT_ID"
          },
          "outputFile": "web/firebase-config.js"
        },
        "flutter_android": {
          "config": {
            "apiKey": "YOUR_ANDROID_API_KEY",
            "appId": "YOUR_ANDROID_APP_ID",
