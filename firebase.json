{
  "projects": [
    {
      "platforms": {
        "flutter_web": {
          "config": {
            "apiKey": "YOUR_API_KEY",
            "appId": "YOUR_APP_ID",
            "messagingSenderId": "YOUR_SENDER_ID",
            "projectId": "faith-mission-app",
            "authDomain": "faith-mission-app.firebaseapp.com",
